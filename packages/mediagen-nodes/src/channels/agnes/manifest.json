[
  {
    "configVersion": 1,
    "channel": "agnes",
    "className": "AgnesTextToImage",
    "moduleName": "image",
    "wire": "inline",
    "outputType": "image",
    "title": "Agnes 文生图",
    "description": "Generate an image with Agnes free-relay flash models (optional image input for i2i). Keywords: agnes 文生图 image generation i2i",
    "sourceUrl": "https://apihub.agnes-ai.com/v1",
    "models": ["agnes-image-2.0-flash", "agnes-image-2.1-flash"],
    "defaultModel": "agnes-image-2.1-flash",
    "timeoutSeconds": 300,
    "requiredSettings": ["AGNES_API_KEY"],
    "fields": [
      { "name": "prompt", "type": "str", "required": true, "default": "", "title": "Prompt" },
      { "name": "model", "type": "enum", "values": "@models", "title": "Model" },
      { "name": "size", "type": "str", "default": "1024x1024", "title": "Size" },
      { "name": "image", "type": "image", "title": "Image (i2i)" }
    ]
  },
  {
    "configVersion": 1,
    "channel": "agnes",
    "className": "AgnesTextToVideo",
    "moduleName": "video",
    "wire": "poll",
    "outputType": "video",
    "title": "Agnes 文生视频",
    "description": "Generate a video with Agnes free-relay models (i2v via image, first+last via keyframes). Keywords: agnes 文生视频 video generation i2v keyframes",
    "sourceUrl": "https://apihub.agnes-ai.com/v1",
    "models": ["agnes-video-v2.0"],
    "defaultModel": "agnes-video-v2.0",
    "pollIntervalMs": 5000,
    "timeoutSeconds": 900,
    "requiredSettings": ["AGNES_API_KEY"],
    "fields": [
      { "name": "prompt", "type": "str", "required": true, "default": "", "title": "Prompt" },
      { "name": "model", "type": "enum", "values": "@models", "title": "Model" },
      { "name": "resolution", "type": "enum", "values": ["720p", "1080p"], "default": "720p", "title": "Resolution" },
      { "name": "num_frames", "type": "enum", "values": [81, 121, 161, 241, 441], "default": 121, "title": "Num frames (1080p max 241)" },
      { "name": "ratio", "type": "enum", "values": ["16:9", "9:16"], "title": "Ratio" },
      { "name": "seed", "type": "int", "min": 0, "title": "Seed" },
      { "name": "image", "type": "image", "title": "Image (i2v)" },
      { "name": "keyframes", "type": "list[image]", "maxItems": 2, "title": "Keyframes (first+last)" }
    ]
  }
]
