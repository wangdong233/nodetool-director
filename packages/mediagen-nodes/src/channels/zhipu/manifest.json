[
  {
    "configVersion": 1,
    "channel": "zhipu",
    "className": "ZhipuTextToImage",
    "moduleName": "image",
    "wire": "inline",
    "outputType": "image",
    "title": "Zhipu 文生图",
    "description": "Generate an image with Zhipu CogView / GLM-Image models. Keywords: zhipu cogview 文生图 image generation",
    "sourceUrl": "https://open.bigmodel.cn/dev/api/cogview/cogview-4",
    "models": ["cogview-3-flash", "cogview-4", "glm-image"],
    "defaultModel": "cogview-3-flash",
    "timeoutSeconds": 120,
    "requiredSettings": ["ZHIPU_API_KEY"],
    "fields": [
      { "name": "prompt", "type": "str", "required": true, "default": "", "title": "Prompt" },
      { "name": "model", "type": "enum", "values": "@models", "title": "Model" },
      { "name": "size", "type": "enum", "values": ["1024x1024", "1440x720", "720x1440"], "default": "1024x1024", "title": "Size" }
    ]
  },
  {
    "configVersion": 1,
    "channel": "zhipu",
    "className": "ZhipuTextToVideo",
    "moduleName": "video",
    "wire": "poll",
    "outputType": "video",
    "title": "Zhipu 文生视频",
    "description": "Generate a video with Zhipu CogVideoX (5s/10s on cogvideox-3, keyframes on cogvideox-3, i2v via image). Keywords: zhipu cogvideox 文生视频 video generation",
    "sourceUrl": "https://open.bigmodel.cn/dev/api/cogvideox/cogvideox-2",
    "models": ["cogvideox-flash", "cogvideox-2", "cogvideox-3"],
    "defaultModel": "cogvideox-flash",
    "pollIntervalMs": 5000,
    "timeoutSeconds": 900,
    "requiredSettings": ["ZHIPU_API_KEY"],
    "fields": [
      { "name": "prompt", "type": "str", "required": true, "default": "", "title": "Prompt" },
      { "name": "model", "type": "enum", "values": "@models", "title": "Model" },
      { "name": "fps", "type": "enum", "values": [30, 60], "default": 30, "title": "FPS" },
      { "name": "duration", "type": "enum", "values": [5, 10], "default": 5, "title": "Duration (s, cogvideox-3 only)" },
      { "name": "image", "type": "image", "title": "Image (i2v)" },
      { "name": "keyframes", "type": "list[image]", "maxItems": 2, "title": "Keyframes (first+last, cogvideox-3 only)" }
    ]
  }
]
