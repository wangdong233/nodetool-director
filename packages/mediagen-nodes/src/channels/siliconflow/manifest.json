[
  {
    "configVersion": 1,
    "channel": "siliconflow",
    "className": "SiliconflowTextToImage",
    "moduleName": "image",
    "wire": "inline",
    "outputType": "image",
    "title": "Siliconflow 生图",
    "description": "Generate an image with SiliconFlow (Kolors free, Z-Image, Qwen-Image, ERNIE). Only the Qwen-Image-Edit models accept an input image via the image field; image_size tiers are per-model fixed upstream (the Kolors tiers are listed). Result URLs expire after one hour, so outputs are downloaded immediately. Keywords: siliconflow kolors qwen-image 生图 image generation",
    "sourceUrl": "https://docs.siliconflow.cn/cn/api-reference/images/images-generations",
    "models": [
      "Kwai-Kolors/Kolors",
      "Tongyi-MAI/Z-Image-Turbo",
      "Tongyi-MAI/Z-Image",
      "Qwen/Qwen-Image",
      "Qwen/Qwen-Image-Edit",
      "Qwen/Qwen-Image-Edit-2509",
      "Baidu/ERNIE-Image-Turbo"
    ],
    "defaultModel": "Kwai-Kolors/Kolors",
    "timeoutSeconds": 120,
    "requiredSettings": ["SILICONFLOW_API_KEY"],
    "fields": [
      { "name": "prompt", "type": "str", "required": true, "default": "", "title": "Prompt" },
      { "name": "model", "type": "enum", "values": "@models", "title": "Model" },
      { "name": "image_size", "type": "enum", "values": ["1024x1024", "960x1280", "768x1024", "720x1440", "720x1280"], "default": "1024x1024", "title": "Image Size (Kolors tiers; tiers are per-model fixed upstream)" },
      { "name": "seed", "type": "int", "title": "Seed" },
      { "name": "image", "type": "image", "title": "Image (Qwen-Image-Edit models only)" }
    ]
  },
  {
    "configVersion": 1,
    "channel": "siliconflow",
    "className": "SiliconflowTextToVideo",
    "moduleName": "video",
    "wire": "poll",
    "outputType": "video",
    "title": "Siliconflow 文生视频",
    "description": "Generate a fixed 5s/24fps video with SiliconFlow Wan2.2 (text-to-video, or image-to-video from a single first frame via image). 720P-class sizes only; no first/last keyframes. Results are held for 10 minutes and URLs expire after one hour, so outputs are downloaded immediately. Keywords: siliconflow wan 文生视频 video generation",
    "sourceUrl": "https://docs.siliconflow.cn/cn/api-reference/videos/video-submit",
    "models": ["Wan-AI/Wan2.2-T2V-A14B", "Wan-AI/Wan2.2-I2V-A14B"],
    "defaultModel": "Wan-AI/Wan2.2-T2V-A14B",
    "pollIntervalMs": 5000,
    "timeoutSeconds": 600,
    "requiredSettings": ["SILICONFLOW_API_KEY"],
    "fields": [
      { "name": "prompt", "type": "str", "required": true, "default": "", "title": "Prompt" },
      { "name": "model", "type": "enum", "values": "@models", "title": "Model" },
      { "name": "image_size", "type": "enum", "values": ["1280x720", "720x1280", "960x960"], "default": "1280x720", "title": "Image Size (16:9 / 9:16 / 1:1)" },
      { "name": "seed", "type": "int", "title": "Seed" },
      { "name": "image", "type": "image", "title": "Image (first frame, I2V model)" }
    ]
  }
]
